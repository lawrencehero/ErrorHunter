# ============================================================
# 错题猎手（ErrorHunter）集成测试 / 本地开发环境
# 使用方式：
#   cp .env.example .env    # 按需修改
#   docker compose up -d    # 启动所有服务
# ============================================================

# -------------------- 应用服务 --------------------
APP_PORT=8080
APP_MODE=debug
CONFIG_PATH=/app/configs/config.yaml

# -------------------- PostgreSQL --------------------
POSTGRES_PORT=5432
POSTGRES_DB=errorhunter
POSTGRES_USER=errorhunter
POSTGRES_PASSWORD=errorhunter_dev
POSTGRES_TEST_DB=errorhunter_test

# -------------------- Redis --------------------
REDIS_PORT=6379
REDIS_PASSWORD=

# -------------------- MinIO (S3-compatible) --------------------
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=errorhunter

# -------------------- JWT --------------------
JWT_ACCESS_SECRET=errorhunter-access-secret-key-change-in-production
JWT_REFRESH_SECRET=errorhunter-refresh-secret-key-change-in-production
JWT_ACCESS_EXPIRE=15
JWT_REFRESH_EXPIRE=10080

# -------------------- OTP --------------------
OTP_EXPIRE=300
OTP_RESEND_INTERVAL=60
OTP_DAILY_LIMIT=10
OTP_MAX_RETRY=5
OTP_LOCKOUT_DURATION=1800

# -------------------- SMS --------------------
SMS_PROVIDER=mock
# 阿里云号码认证服务（生产环境设置）
# SMS_PROVIDER=aliyun
# EH_SMS_ALIYUN_ACCESS_KEY=your-access-key-id
# EH_SMS_ALIYUN_SECRET_KEY=your-access-key-secret
# EH_SMS_ALIYUN_SIGN_NAME=错题猎手
# EH_SMS_ALIYUN_TEMPLATE_CODE=azsq_*****
# EH_SMS_ALIYUN_CODE_LENGTH=6
# EH_SMS_ALIYUN_VALID_TIME=300

# -------------------- OCR --------------------
OCR_PROVIDER=mock
OCR_TIMEOUT=8
# 阿里云读光 OCR（生产环境设置）
# OCR_PROVIDER=aliyun
# EH_OCR_ALIYUN_ACCESS_KEY=your-access-key-id
# EH_OCR_ALIYUN_SECRET_KEY=your-access-key-secret
# EH_OCR_ALIYUN_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com

# -------------------- 通用 --------------------
COMPOSE_PROJECT_NAME=errorhunter
TZ=Asia/Shanghai
